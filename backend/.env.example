# Copy to backend/.env and fill in what you need. Everything is optional.

# Free Gemini API key from https://aistudio.google.com/app/apikey
# Without it the assistant answers from the offline knowledge base.
GEMINI_API_KEY=
# Leave empty to auto-pick the newest "flash" model available to your key.
GEMINI_MODEL=

# CPU threads for the ONNX model (use 1 on small free servers).
PHYTO_THREADS=2
# Below this confidence the app says "not sure – retake".
PHYTO_MIN_CONFIDENCE=0.55
